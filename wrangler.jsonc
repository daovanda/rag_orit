/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ragorit",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-07",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"keep_vars": true,

	"vars": {
		"ZILCODE_BASE": "https://dvnb.zilcode.vn",
		"SESSION_TTL_SECONDS": "28800"
	},

	"ai": {
		"binding": "AI"
	},

	// Vectorize index for RAG — dimensions must match bge-m3 output (1024)
	// Create with: wrangler vectorize create zilcode-docs --dimensions=1024 --metric=cosine
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "zilcode-docs"
		}
	],

	// KV namespace to store chunk text (Vectorize only stores vectors, not text)
	// Zilcode login sessions are also stored here with prefix zilcode_session: for the current MVP.
	// For production, create a separate KV binding named ZILCODE_SESSIONS and keep tokens outside CHUNKS.
	// Create with: wrangler kv namespace create CHUNKS
	// Then replace <KV_NAMESPACE_ID> below with the returned id
	"kv_namespaces": [
		{
			"binding": "CHUNKS",
			"id": "806fc1dbdf0c4a8b90150ed6b664a200"
		}
	],

	// Async agent production state.
	// Full setup guide: doc/async-jobs-production-setup.md
	// Create with: npx wrangler d1 create ragorit-agent-db
	// Apply migration: npx wrangler d1 migrations apply ragorit-agent-db --remote
	// Bound as env.DB for conversation/job/pending action state.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ragorit-agent-db",
			"database_id": "d24f3fe5-74db-4820-a319-7150290b341e"
		}
	],

	// Production queue for background agent jobs.
	// Created with: npx wrangler queues create ragorit-agent-jobs
	"queues": {
		"producers": [
			{ "binding": "AGENT_JOBS", "queue": "ragorit-agent-jobs" }
		],
		"consumers": [
			{ "queue": "ragorit-agent-jobs", "max_batch_size": 1, "max_batch_timeout": 1 }
		]
	},

	// Periodic cleanup for expired jobs/pending actions and old job events.
	"triggers": {
		"crons": ["*/30 * * * *"]
	},

	/**
	 * Secrets (set via CLI, never in this file):
	 *   wrangler secret put ZILCODE_API_TOKEN
	 *
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }
}
