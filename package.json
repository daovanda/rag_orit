{
  "name": "ragorit",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote --config wrangler.remote-dev.jsonc",
    "start": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest --config vitest.worker.config.mts",
    "smoke:offline": "vitest run test/app-builder-read-coverage.test.ts test/app-builder-prepare-integration.test.ts test/app-builder-recovery.test.ts test/app-builder-verification.test.ts test/security-redaction.test.ts",
    "rag:dry-run": "vite-node scripts/ingest.ts --replace --dry-run",
    "rag:sync": "vite-node scripts/ingest.ts --replace",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.6.0",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.88.0"
  },
  "dependencies": {
    "@cloudflare/ai": "^1.2.2",
    "dotenv": "^17.4.2",
    "pdf2pic": "^3.2.0",
    "sharp": "^0.34.5"
  }
}
